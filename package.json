{
  "name": "nexine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, no-egress developer utility platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @nexine/host dev",
    "dev:desktop": "pnpm --filter @nexine/host dev:desktop",
    "build": "pnpm --filter @nexine/host build",
    "build:desktop": "pnpm --filter @nexine/host build:desktop",
    "build:cli": "pnpm --filter @nexine/cli build",
    "bump": "node scripts/bump-version.mjs",
    "nexine": "node packages/cli/dist/bin.js",
    "preview": "pnpm --filter @nexine/host preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
