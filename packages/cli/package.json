{
  "name": "@nexine/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The `nexine` developer CLI: generate signing keys, bundle a plugin's source into a signed package, and verify/inspect packages before side-loading.",
  "license": "MIT",
  "bin": {
    "nexine": "./dist/bin.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexine/core": "workspace:*",
    "@nexine/packaging": "workspace:*",
    "@nexine/sdk": "workspace:*",
    "esbuild": "^0.25.0"
  }
}
