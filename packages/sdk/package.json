    ".": "./src/index.ts",
    "./guest": "./src/guest/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexine/core": "workspace:*"
  }
}
